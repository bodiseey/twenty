# --- ASAMBLOR CRM DEPLOYMENT CONFIGURATION ---

# The URL where your CRM will be accessible (e.g., https://crm.asamblor.com)
SERVER_URL=http://localhost:3000

# Database Configuration
PG_DATABASE_USER=asamblor_admin
PG_DATABASE_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
PG_DATABASE_NAME=twenty
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379

# App Secret (CRITICAL: Generate a 32-char random string)
# You can use: openssl rand -base64 32
APP_SECRET=REPLACE_ME_WITH_RANDOM_STRING

# Storage Configuration
# Set to 'local' for starter, or 's3' for production scaling
STORAGE_TYPE=local

# --- Optional Email Configuration (SMTP) ---
# EMAIL_FROM_ADDRESS=contact@asamblor.com
# EMAIL_FROM_NAME="Asamblor Command Center"
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password
